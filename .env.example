# Variabili d'ambiente per Trento Bike Parking
# Copia questo file in .env e compila i valori

# --- Google OAuth 2.0 ---
# Crea le tue credenziali su: https://console.cloud.google.com/apis/credentials
# Tipo: "ID client OAuth 2.0" > Applicazione web
# Aggiungi come "URI di reindirizzamento JavaScript autorizzati": http://localhost:3000
GOOGLE_CLIENT_ID=IL_TUO_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# --- JWT ---
# Una stringa casuale e lunga da usare come firma segreta dei token JWT
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SUPER_SECRET=cambia-questa-stringa-segreta-in-produzione

# --- Server ---
PORT=3000
