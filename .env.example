# =================================================================
# CONFIGURAZIONE CYCLE PLACE - AMBIENTE DI PRODUZIONE E SVILUPPO
# =================================================================
# Copia questo file in '.env' e imposta i valori reali prima di avviare il server.
# NON committare mai il file .env reale nel repository git!

# Ambiente di esecuzione ('production' o 'development')
NODE_ENV=production

# Porta su cui rimarrà in ascolto il server Express
PORT=3000

# URL pubblico del servizio (usato per i link nelle email di recupero password)
APP_URL=https://tuodominio.it

# Domini autorizzati per le richieste CORS (separati da virgola in produzione)
# Esempio: https://cycleplace.it,https://www.cycleplace.it
ALLOWED_ORIGINS=https://tuodominio.it

# -----------------------------------------------------------------
# SICUREZZA & TOKEN JWT (CRITICO: Genera chiavi crittografiche casuali)
# Per generare una chiave casuale sicura a 256 bit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------
# Chiave segreta per la firma degli Access Token JWT (validità 15m)
SUPER_SECRET=inserisci_qui_una_stringa_casuale_segreta_a_256_bit

# Chiave segreta separata per i Refresh Token JWT (validità 30 giorni)
JWT_REFRESH_SECRET=inserisci_qui_un_altra_stringa_casuale_segreta_a_256_bit

# -----------------------------------------------------------------
# GOOGLE OAUTH 2.0 (Single Sign-On)
# Ottenibile da Google Cloud Console -> API e servizi -> Credenziali
# Ricordati di aggiungere il tuo dominio di produzione nelle 'Origini JavaScript autorizzate'
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=tuo_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------
# OPENROUTESERVICE API (Calcolo percorsi ciclabili/pedonali)
# Registrazione gratuita su: https://openrouteservice.org/
# (Nota: se lasciato vuoto, Cycle Place userà automaticamente il motore OSRM gratuito come fallback)
# -----------------------------------------------------------------
ORS_API_KEY=

# -----------------------------------------------------------------
# SERVIZIO EMAIL SMTP (Invio email reali di recupero password)
# (Se non configurato, in sviluppo locale verrà usato un account Ethereal di test temporaneo)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tua_email@gmail.com
# Per Gmail, usa una "Password per le app" generata nelle impostazioni di sicurezza Google
SMTP_PASS=tua_password_app_google
SMTP_FROM="Cycle Place" <noreply@tuodominio.it>
