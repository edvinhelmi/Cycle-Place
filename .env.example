# Configurazione Server Cycle Place
PORT=3000

# Google OAuth 2.0 Client ID per Single Sign-On
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Chiave segreta per la firma crittografica dei JWT
SUPER_SECRET=your_jwt_secret_key_here

# OpenRouteService API Key (per calcolo percorsi bici/pedonali in-app e navigazione live)
# È già presente una chiave di default nel codice per il funzionamento out-of-the-box.
# È possibile ottenere una chiave personale gratuita registrandosi su https://openrouteservice.org/
ORS_API_KEY=

# Servizio Email per Recupero Password (RF 1.4 / US 3)
# (Opzionale: se non specificato, il server userà un account di test Ethereal per lo sviluppo locale)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Trento Bike Parking" <noreply@trentobikeparking.it>
